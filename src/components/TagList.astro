---
interface Props {
  tags?: string[];
}

const { tags = [] } = Astro.props;
---

{
  tags.length > 0 && (
    <span class="tags" aria-label="Tags">
      {tags.map((tag) => (
        <span class="tag">[{tag}]</span>
      ))}
    </span>
  )
}

<style>
  .tags {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    color: var(--text-faint);
    font-size: 0.8rem;
  }
</style>
