---
import Layout from "../layouts/Layout.astro";
import PageContainer from "../components/PageContainer.astro";
import SectionHeading from "../components/SectionHeading.astro";

// Static content, so the page is built once instead of on every request.
export const prerender = true;
---

<Layout title="contact" description="How to get in touch with Aaron Minhas.">
  <PageContainer>
    <SectionHeading as="h1">contact</SectionHeading>
    <p>Best way to reach me is by email.</p>

    <p class="email">
      <a href="mailto:contact@aaronminhas.com">contact@aaronminhas.com</a>
    </p>

    <ul class="links">
      <li>
        <a
          href="https://github.com/aaronminhas"
          target="_blank"
          rel="noreferrer noopener"
          class="link-entry"
        >
          <span class="name">GitHub</span>
          <span class="blurb">code & projects</span>
        </a>
      </li>
      <li>
        <a
          href="https://linkedin.com/in/aaronminhas"
          target="_blank"
          rel="noreferrer noopener"
          class="link-entry"
        >
          <span class="name">LinkedIn</span>
          <span class="blurb">professional profile</span>
        </a>
      </li>
    </ul>
  </PageContainer>
</Layout>

<style>
  p {
    color: var(--text-muted);
    margin: 0 0 0.5rem;
  }

  .email a {
    color: var(--text);
  }

  .links {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
  }

  .links li {
    margin-bottom: 0;
  }

  .link-entry {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.25rem 0.5rem;
    margin: 0 -0.5rem;
    border-radius: 4px;
    text-decoration: none;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }

  .link-entry:hover {
    background: rgba(128, 128, 128, 0.1);
  }

  .link-entry .name {
    color: var(--text-faint);
  }

  .link-entry:hover .name {
    color: var(--text);
  }

  .link-entry .blurb {
    color: var(--text-faint);
    font-size: 0.85rem;
  }
</style>
