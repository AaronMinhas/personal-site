---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { blog: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

if (!post) {
  return Astro.redirect("/blog");
}

const { Content } = await post.render();
const formattedDate = new Intl.DateTimeFormat("en", {
  day: "numeric",
  month: "long",
  year: "numeric",
}).format(post.data.date);
---

<Layout
  title={`${post.data.title} - Aaron`}
  description={post.data.description}
>
  <main class="page">
    <article>
      <header>
        <h1>{post.data.title}</h1>
        <time>{formattedDate}</time>
      </header>

      <div class="content">
        <Content />
      </div>
    </article>
  </main>
</Layout>

<style>
  .page {
    max-width: 52rem;
    margin: 0 auto;
    padding: 0 1.5rem 2rem;
  }

  header {
    margin-bottom: 2rem;
  }

  h1 {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 0.25rem;
    line-height: 1.4;
    color: var(--text);
  }

  time {
    color: var(--text-faint);
    font-size: 0.9rem;
  }

  .content {
    color: var(--text-muted);
  }

  .content :global(p) {
    margin: 0 0 1rem;
  }

  .content :global(h2) {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
    margin: 2rem 0 0.5rem;
  }

  .content :global(h3) {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
    margin: 1.5rem 0 0.5rem;
  }

  .content :global(a) {
    color: var(--link);
  }

  .content :global(strong) {
    font-weight: 600;
    color: var(--text);
  }

  .content :global(ul),
  .content :global(ol) {
    margin: 0 0 1rem;
    padding-left: 1.5rem;
  }

  .content :global(li) {
    margin-bottom: 0.25rem;
  }

  .content :global(code) {
    background: var(--border);
    padding: 0.1rem 0.3rem;
    border-radius: 3px;
    font-size: 0.9em;
    font-family: ui-monospace, monospace;
  }

  .content :global(pre) {
    background: var(--border);
    padding: 1rem;
    border-radius: 4px;
    overflow-x: auto;
    margin: 0 0 1rem;
  }

  .content :global(pre code) {
    background: none;
    padding: 0;
  }

  .content :global(blockquote) {
    border-left: 2px solid var(--border);
    padding-left: 1rem;
    margin: 0 0 1rem;
    color: var(--text-faint);
  }

  .content :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2rem 0;
  }
</style>
