---
interface Props {
	/** Page name; the site name is appended for every page but the homepage. */
	title: string;
	description?: string;
}
const { title, description } = Astro.props;

const siteName = "Aaron Minhas";
const pageTitle = title === siteName ? siteName : `${title} · ${siteName}`;
const pageDescription =
	description ?? "The personal website of Aaron Minhas.";
import "../styles/global.css";
import { getCollection } from "astro:content";

// Pre-built pages report their file path ("/projects.html"), so normalise to
// the address visitors use ("/projects").
const pathname =
	Astro.url.pathname.replace(/\.html$/, "").replace(/(.)\/$/, "$1") || "/";
const canonicalUrl =
	Astro.site && pathname !== "/404"
		? new URL(pathname, Astro.site).href
		: undefined;

// Injected at build time by astro.config.mjs.
declare const __BUILD_COMMIT__: string;
const repoUrl = "https://github.com/AaronMinhas/personal-site";
const firstYear = 2025;
const currentYear = new Date().getFullYear();
const years =
	currentYear > firstYear ? `${firstYear}–${currentYear}` : `${firstYear}`;

// The writing link only appears once there is a published post.
const hasPosts =
	(await getCollection("posts", ({ data }) => !data.draft)).length > 0;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={pageDescription} />
		{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={pageDescription} />
		{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
		<meta name="twitter:card" content="summary" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link
			rel="preload"
			href="/fonts/jetbrains-mono/JetBrainsMono-Medium.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/libron/Libron-Regular.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<title>{pageTitle}</title>
		<script is:inline>
			(function () {
				let theme = null;
				try {
					theme = localStorage.getItem("theme");
				} catch (e) {
					/* storage blocked: fall back to the system setting */
				}
				if (!theme) {
					theme = window.matchMedia("(prefers-color-scheme: dark)").matches
						? "dark"
						: "light";
				}
				document.documentElement.setAttribute("data-theme", theme);
			})();
		</script>
	</head>
	<body>
		<header class="navbar">
			<a href="/" class="name">Aaron</a>
			<nav>
				{
					hasPosts && (
						<a
							href="/blog"
							class:list={[{ active: pathname.startsWith("/blog") }]}
						>
							writing
						</a>
					)
				}
				<a
					href="/recommendations"
					class:list={[
						{ active: pathname.startsWith("/recommendations") },
					]}>recommendations</a
				>
				<a
					href="/projects"
					class:list={[
						{ active: pathname === "/projects" },
					]}>projects</a
				>
				<a
					href="/contact"
					class:list={[
						{ active: pathname === "/contact" },
					]}>contact</a
				>
				<button id="theme-toggle" class="toggle">invert</button>
			</nav>
		</header>
		<slot />
		<footer class="site-footer">
			<div class="footer-row">
				<span>© {years} Aaron Minhas</span>
				<div class="footer-links">
					{
						__BUILD_COMMIT__ && (
							<span>
								built from{" "}
								<a
									href={`${repoUrl}/commit/${__BUILD_COMMIT__}`}
									target="_blank"
									rel="noopener noreferrer"
								>
									{__BUILD_COMMIT__.slice(0, 7)}
								</a>
							</span>
						)
					}
					<a href={repoUrl} target="_blank" rel="noopener noreferrer">
						source
					</a>
				</div>
			</div>
		</footer>
		<script is:inline>
			// Theme toggle: curtain-slide swap via the View Transitions API.
			const toggle = document.getElementById("theme-toggle");
			const root = document.documentElement;

			function applyTheme(next) {
				root.setAttribute("data-theme", next);
				try {
					localStorage.setItem("theme", next);
				} catch (e) {}
			}

			toggle?.addEventListener("click", () => {
				const current = root.getAttribute("data-theme");
				const next = current === "dark" ? "light" : "dark";
				const reduce = window.matchMedia(
					"(prefers-reduced-motion: reduce)",
				).matches;

				if (!document.startViewTransition || reduce) {
					applyTheme(next);
					return;
				}
				document.startViewTransition(() => applyTheme(next));
			});

			// Modular hover preview. Any element with a [data-preview] attribute
			// shows a floating image card near the cursor. See Preview.astro.
			(function initPreview() {
				const card = document.createElement("div");
				card.className = "preview-card";
				const img = document.createElement("img");
				card.appendChild(img);
				document.body.appendChild(card);

				const previewSelector = "[data-preview]";
				let current = null;
				let hideTimer = null;

				function position(e) {
					const pad = 16;
					const cw = card.offsetWidth || 320;
					const ch = card.offsetHeight || 213;
					let x = e.clientX + pad;
					let y = e.clientY + pad;
					if (x + cw + pad > innerWidth) x = e.clientX - cw - pad;
					if (y + ch + pad > innerHeight) y = e.clientY - ch - pad;
					if (x < pad) x = pad;
					if (y < pad) y = pad;
					card.style.left = x + "px";
					card.style.top = y + "px";
				}

				function show(el, e) {
					const src = el.getAttribute("data-preview");
					if (!src) return;
					clearTimeout(hideTimer);
					current = el;
					card.classList.toggle(
						"square",
						el.getAttribute("data-preview-shape") === "square",
					);
					if (img.getAttribute("src") !== src) {
						card.classList.remove("dark-image", "light-image");
						img.src = src;
						img.alt = el.getAttribute("data-preview-alt") || "";
					}
					position(e);
					card.classList.remove("fading");
					card.classList.add("visible");
				}

				function hide() {
					current = null;
					card.classList.remove("visible");
					card.classList.add("fading");
					hideTimer = setTimeout(
						() => card.classList.remove("fading"),
						200,
					);
				}

				document.addEventListener("mouseover", (e) => {
					const el = e.target.closest && e.target.closest(previewSelector);
					if (el) show(el, e);
				});
				document.addEventListener("mouseout", (e) => {
					const el = e.target.closest && e.target.closest(previewSelector);
					if (el && !el.contains(e.relatedTarget)) hide();
				});
				document.addEventListener("mousemove", (e) => {
					if (current) position(e);
				});

				// Adaptive border: white frame for dark images, black for light.
				// Cross-origin images taint the canvas, so the read is defensive.
				img.addEventListener("load", () => {
					try {
						const c = document.createElement("canvas");
						c.width = 16;
						c.height = 16;
						const ctx = c.getContext("2d");
						ctx.drawImage(img, 0, 0, 16, 16);
						const d = ctx.getImageData(0, 0, 16, 16).data;
						let sum = 0,
							n = 0;
						for (let i = 0; i < d.length; i += 4) {
							sum += d[i] * 0.299 + d[i + 1] * 0.587 + d[i + 2] * 0.114;
							n++;
						}
						const avg = sum / n;
						card.classList.toggle("dark-image", avg < 128);
						card.classList.toggle("light-image", avg >= 128);
					} catch (e) {
						/* tainted canvas — keep default border */
					}
				});

				// Modal for <Preview modal> triggers ([data-modal]). When the trigger
				// is a link, the modal's image and title link out to it instead.
				const modal = document.createElement("div");
				modal.className = "preview-modal";
				modal.setAttribute("role", "dialog");
				modal.setAttribute("aria-modal", "true");
				modal.innerHTML =
					'<button class="preview-modal-close" aria-label="Close">\u00d7</button>' +
					'<figure><a class="preview-modal-image" tabindex="-1"><img alt="" /></a>' +
					'<figcaption><a class="preview-modal-title"></a>' +
					'<span class="preview-modal-caption"></span>' +
					'<div class="preview-modal-notes"></div></figcaption></figure>';
				document.body.appendChild(modal);
				const modalImg = modal.querySelector("img");
				const modalCap = modal.querySelector("figcaption");
				const modalTitle = modal.querySelector(".preview-modal-title");
				const modalCapText = modal.querySelector(".preview-modal-caption");
				const modalNotes = modal.querySelector(".preview-modal-notes");
				const modalLinks = modal.querySelectorAll("figure a");
				const modalClose = modal.querySelector(".preview-modal-close");
				// Where keyboard focus was before the modal opened.
				let returnFocus = null;

				function openModal(src, alt, title, caption, href, notes) {
					// No image means a text-only modal (see .preview-modal.text-only).
					modal.classList.toggle("text-only", !src);
					if (src) {
						modalImg.src = src;
						modalImg.alt = alt || "";
					} else {
						modalImg.removeAttribute("src");
					}

					// Without an href the anchors are inert, so they read as plain content.
					modalLinks.forEach((link) => {
						if (href) {
							link.href = href;
							link.target = "_blank";
							link.rel = "noopener noreferrer";
						} else {
							link.removeAttribute("href");
						}
					});

					if (title) {
						modalTitle.textContent = title;
						modalTitle.style.display = "";
					} else {
						modalTitle.style.display = "none";
					}

					// Visible caption falls back to alt text when not provided.
					const capText = caption || alt;
					if (capText) {
						modalCapText.textContent = capText;
						modalCapText.style.display = "";
					} else {
						modalCapText.style.display = "none";
					}

					// Notes arrive as a JSON array of paragraphs (see Preview.astro).
					const paragraphs = notes ? JSON.parse(notes) : [];
					modalNotes.replaceChildren(
						...paragraphs.map((text) => {
							const p = document.createElement("p");
							p.textContent = text;
							return p;
						}),
					);
					modalNotes.style.display = paragraphs.length ? "" : "none";

					modalCap.style.display =
						title || capText || paragraphs.length ? "" : "none";
					modal.querySelector("figure").scrollTop = 0;
					modal.setAttribute("aria-label", title || capText || "Preview");
					returnFocus = document.activeElement;
					modal.classList.add("open");
					// Keep the page behind from scrolling, and move focus inside.
					root.style.overflow = "hidden";
					modalClose.focus();
					hide();
				}

				function closeModal() {
					if (!modal.classList.contains("open")) return;
					modal.classList.remove("open");
					root.style.overflow = "";
					if (returnFocus && returnFocus.focus) returnFocus.focus();
					returnFocus = null;
				}

				document.addEventListener("click", (e) => {
					const t = e.target.closest && e.target.closest("[data-modal]");
					if (!t) return;
					// Leave modified clicks alone so a link trigger can still open in a new tab.
					if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
					e.preventDefault();
					openModal(
						t.getAttribute("data-preview"),
						t.getAttribute("data-preview-alt"),
						t.getAttribute("data-preview-title"),
						t.getAttribute("data-preview-caption"),
						t.getAttribute("href"),
						t.getAttribute("data-preview-notes"),
					);
				});
				// Non-link triggers are role="button", so give them button keys.
				document.addEventListener("keydown", (e) => {
					if (e.key !== "Enter" && e.key !== " ") return;
					const t = e.target;
					if (t.matches && t.matches('[data-modal][role="button"]')) {
						e.preventDefault();
						t.click();
					}
				});
				modal.addEventListener("click", (e) => {
					if (e.target === modal || e.target.closest(".preview-modal-close")) {
						closeModal();
					}
				});
				window.addEventListener("keydown", (e) => {
					if (!modal.classList.contains("open")) return;
					if (e.key === "Escape") closeModal();
					// Keep Tab cycling through the modal's own controls.
					if (e.key === "Tab") {
						const stops = [modalClose, modalTitle].filter(
							(el) => el === modalClose || el.hasAttribute("href"),
						);
						const index = stops.indexOf(document.activeElement);
						const step = e.shiftKey ? -1 : 1;
						e.preventDefault();
						stops[(index + step + stops.length) % stops.length].focus();
					}
				});
			})();
		</script>
	</body>
</html>

<style is:global>
	:root {
		--bg: #fcfcfb;
		--text: #17181a;
		--text-muted: #5b5d61;
		--text-faint: #717478;
		--border: #e4e4e2;
		--link: #0645ad;
	}

	[data-theme="dark"] {
		--bg: #0f0f0f;
		--text: #e8e8e8;
		--text-muted: #9c9c9c;
		--text-faint: #7d7d7d;
		--border: #252525;
		--link: #7aa2f7;
	}

	/* JetBrains Mono (SIL OFL, see public/fonts/jetbrains-mono/OFL.txt): the
	   site's monospace, self-hosted so it looks the same on every device */
	@font-face {
		font-family: "JetBrains Mono";
		src: url("/fonts/jetbrains-mono/JetBrainsMono-Regular.woff2") format("woff2");
		font-weight: 400;
		font-style: normal;
		font-display: swap;
	}
	@font-face {
		font-family: "JetBrains Mono";
		src: url("/fonts/jetbrains-mono/JetBrainsMono-Medium.woff2") format("woff2");
		font-weight: 500;
		font-style: normal;
		font-display: swap;
	}
	@font-face {
		font-family: "JetBrains Mono";
		src: url("/fonts/jetbrains-mono/JetBrainsMono-SemiBold.woff2") format("woff2");
		font-weight: 600;
		font-style: normal;
		font-display: swap;
	}
	@font-face {
		font-family: "JetBrains Mono";
		src: url("/fonts/jetbrains-mono/JetBrainsMono-Bold.woff2") format("woff2");
		font-weight: 700;
		font-style: normal;
		font-display: swap;
	}

	/* Libron (SIL OFL, see public/fonts/libron/OFL.txt): the prose font */
	@font-face {
		font-family: "Libron";
		src: url("/fonts/libron/Libron-Regular.woff2") format("woff2");
		font-weight: 400;
		font-style: normal;
		font-display: swap;
	}
	@font-face {
		font-family: "Libron";
		src: url("/fonts/libron/Libron-Italic.woff2") format("woff2");
		font-weight: 400;
		font-style: italic;
		font-display: swap;
	}
	@font-face {
		font-family: "Libron";
		src: url("/fonts/libron/Libron-Bold.woff2") format("woff2");
		font-weight: 700;
		font-style: normal;
		font-display: swap;
	}
	@font-face {
		font-family: "Libron";
		src: url("/fonts/libron/Libron-BoldItalic.woff2") format("woff2");
		font-weight: 700;
		font-style: italic;
		font-display: swap;
	}

	html {
		--font-mono:
			"JetBrains Mono", ui-monospace, "SF Mono", "Cascadia Code", "Consolas",
			monospace;
		--font-prose: "Libron", Georgia, serif;
		/* width of the content column shared by the navbar, pages and footer */
		--page-width: 56rem;
		font-family: var(--font-mono);
		font-size: 14px;
		font-weight: 500;
		line-height: 1.6;
	}

	/* Running text is set in Libron; the menu, headings, labels, lists and
	   dates stay monospace. Covers page paragraphs, blog post bodies and
	   the text inside preview modals. */
	main p:not(.title, .email),
	main article .content,
	.preview-modal-caption,
	.preview-modal-notes {
		font-family: var(--font-prose);
		font-size: 1.2rem;
		font-weight: 400;
		/* avoid a lone word on a paragraph's last line */
		text-wrap: pretty;
	}

	main article .content :is(h1, h2, h3, h4, pre, code, kbd) {
		font-family: var(--font-mono);
	}

	main article .content :is(pre, code, kbd) {
		font-size: 0.85em;
	}

	/* column layout so the footer sits at the bottom of short pages */
	body {
		display: flex;
		flex-direction: column;
		min-height: 100dvh;
		background: var(--bg);
		color: var(--text);
		-webkit-font-smoothing: antialiased;
	}

	::selection {
		background: rgba(100, 100, 100, 0.2);
	}

	.navbar {
		box-sizing: border-box;
		width: 100%;
		max-width: var(--page-width);
		margin: 0 auto;
		padding: 2rem 1.5rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	/* the name: on hover a band of the link colour drifts through the
	   letters on a loop (a gradient clipped to the text) */
	.navbar .name {
		font-size: 1.25rem;
		font-weight: 600;
		color: var(--text);
		text-decoration: none;
		background-image: linear-gradient(
			90deg,
			var(--text),
			var(--link),
			var(--text)
		);
		background-size: 200% 100%;
		-webkit-background-clip: text;
		background-clip: text;
		transition: color 0.25s ease;
	}

	.navbar .name:hover,
	.navbar .name:focus-visible {
		color: transparent;
		animation: name-drift 3s linear infinite;
	}

	@keyframes name-drift {
		to {
			background-position: 200% 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.navbar .name:hover,
		.navbar .name:focus-visible {
			animation: none;
		}
	}

	.navbar nav {
		display: flex;
		gap: 1.5rem;
		align-items: center;
	}

	.navbar nav a {
		color: var(--text-muted);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.navbar nav a:hover {
		color: var(--text);
	}

	.navbar nav a.active {
		color: var(--text);
	}

	.navbar .toggle {
		background: none;
		border: none;
		cursor: pointer;
		font-size: inherit;
		font-family: inherit;
		color: var(--text-faint);
		text-decoration: none;
		padding: 0.2rem 0.5rem;
		border: 1px solid var(--border);
		border-radius: 3px;
	}

	.navbar .toggle:hover {
		color: var(--text-muted);
		border-color: var(--text-faint);
	}

	@media (max-width: 700px) {
		.navbar {
			align-items: flex-start;
			flex-direction: column;
			gap: 1rem;
			padding: 1.5rem;
		}

		.navbar nav {
			flex-wrap: wrap;
			gap: 0.75rem 1rem;
		}
	}

	/* theme toggle: curtain-slide via View Transitions API */
	::view-transition-old(root) {
		animation: curtain-slide 340ms cubic-bezier(0.61, 0.03, 0.08, 1) forwards;
		z-index: 2;
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.28);
	}

	::view-transition-new(root) {
		animation: none;
		z-index: 1;
	}

	@keyframes curtain-slide {
		from {
			transform: translateY(0);
		}
		to {
			transform: translateY(100vh);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		::view-transition-old(root),
		::view-transition-new(root) {
			animation: none;
		}
	}

	/* site footer: mirrors the navbar, with copyright left and links right */
	.site-footer {
		box-sizing: border-box;
		width: 100%;
		max-width: var(--page-width);
		margin: auto auto 0;
		padding: 3rem 1.5rem 0;
	}

	.footer-row {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		padding: 1.25rem 0 2rem;
		border-top: 1px solid var(--border);
		font-size: 0.85rem;
		color: var(--text-faint);
	}

	.footer-links {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.5rem 1.5rem;
	}

	/* same underlined treatment as the nav links */
	.site-footer a {
		color: var(--text-muted);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.site-footer a:hover {
		color: var(--text);
	}

	/* hover image preview (modular: see Preview.astro / [data-preview]) */
	.preview-trigger {
		color: inherit;
		text-decoration: underline dotted var(--text-faint);
		text-underline-offset: 3px;
		text-decoration-thickness: 1px;
		cursor: inherit;
	}

	.preview-trigger.clickable {
		cursor: pointer;
	}

	.preview-trigger.clickable:hover {
		color: var(--link);
		text-decoration-color: var(--link);
	}

	.preview-card {
		position: fixed;
		left: 0;
		top: 0;
		z-index: 1000;
		pointer-events: none;
		opacity: 0;
		transform: translateY(8px);
		transition:
			opacity 0.15s ease,
			transform 0.15s ease;
		border-radius: 6px;
		overflow: hidden;
		border: 1px solid var(--border);
		background: var(--bg);
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.18);
	}

	.preview-card.visible {
		opacity: 1;
		transform: translateY(0);
	}

	.preview-card.fading {
		opacity: 0;
		transform: translateY(0);
	}

	.preview-card.dark-image {
		border-color: #ffffff;
	}

	.preview-card.light-image {
		border-color: #000000;
	}

	.preview-card img {
		display: block;
		width: 320px;
		height: 213px;
		object-fit: cover;
		background: var(--bg);
	}

	/* square variant for portraits (data-preview-shape="square") */
	.preview-card.square img {
